DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blog_api"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# The single author account, created/updated by `npm run seed`
AUTHOR_USERNAME="author"
AUTHOR_PASSWORD="change-me"
SEED_SAMPLE_POST="true"

# Comma-separated frontend origins allowed by CORS. Leave empty in development.
CLIENT_ORIGINS=""
